diff --git a/src/lib.rs b/src/lib.rs
index 7c2e896..af65ca0 100644
--- a/src/lib.rs
+++ b/src/lib.rs
@@ -170,12 +170,57 @@ impl<'a> From<&'a OwnedPrefixedName> for OwnedPrefixedName {
     }
 }
 
-#[derive(Debug, Clone, PartialEq, Eq, Hash)]
+#[derive(Debug, Clone, PartialEq, Eq)]
 pub struct OwnedQName {
     namespace_uri: Option<String>,
     local_part: String,
 }
 
+/// Lets a map keyed by `OwnedQName` be searched with a borrowed
+/// `QName`, without allocating an `OwnedQName` for the lookup.
+pub(crate) trait QNameParts {
+    fn parts(&self) -> (Option<&str>, &str);
+}
+
+impl QNameParts for OwnedQName {
+    fn parts(&self) -> (Option<&str>, &str) {
+        (self.namespace_uri.as_deref(), &self.local_part)
+    }
+}
+
+impl QNameParts for QName<'_> {
+    fn parts(&self) -> (Option<&str>, &str) {
+        (self.namespace_uri(), self.local_part())
+    }
+}
+
+impl<'a> std::borrow::Borrow<dyn QNameParts + 'a> for OwnedQName {
+    fn borrow(&self) -> &(dyn QNameParts + 'a) {
+        self
+    }
+}
+
+impl std::hash::Hash for dyn QNameParts + '_ {
+    fn hash<H: std::hash::Hasher>(&self, state: &mut H) {
+        self.parts().hash(state)
+    }
+}
+
+impl PartialEq for dyn QNameParts + '_ {
+    fn eq(&self, other: &Self) -> bool {
+        self.parts() == other.parts()
+    }
+}
+
+impl Eq for dyn QNameParts + '_ {}
+
+// Must hash the same way as `dyn QNameParts`
+impl std::hash::Hash for OwnedQName {
+    fn hash<H: std::hash::Hasher>(&self, state: &mut H) {
+        self.parts().hash(state)
+    }
+}
+
 impl<'a> From<&'a str> for OwnedQName {
     fn from(local_part: &'a str) -> Self {
         OwnedQName {
